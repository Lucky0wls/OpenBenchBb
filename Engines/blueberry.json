{
    "private": false,
    "nps": 8500000,
    "source": "https://github.com/Lucky0wls/blueberry",

    "build": {
        "path": "src/",
        "compilers": ["g++"],
        "cpuflags": [],
        "systems": ["Linux", "Windows", "Darwin"]
    },

    "test_presets": {
	    "default": {
	        "base_branch": "main",
	        "book_name": "UHO_Lichess_4852_v1.epd",
	        "test_bounds": "[0.00, 5.00]",
	        "test_confidence": "[0.05, 0.05]",
	        "win_adj": "None",
	        "draw_adj": "None"
	    },

	    "non_regression": {
	        "test_bounds": "[-5.00, 0.00]"
	    },

        "STC": {
            "both_options": "Threads=1 Hash=1",
            "both_time_control": "8+0.08",
            "workload_size": 32
        },
	
	    "LTC": {
	        "both_options": "Threads=1 Hash=1",
	        "both_time_control": "60+0.6",
	        "workload_size": 8
	    }
    },

    "tunemodes": {}
}
